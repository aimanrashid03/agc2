# AGC2 — on-prem VM environment template.
# Copy to .env.local ON THE VM and fill in real values. This differs from .env.example
# (dev) only by configuration: chat is served by local Ollama (not OpenRouter), AUTH_URL is
# the real HTTPS URL, and MYSQL_* point at the client's database. See docs/vm-deployment.md.

# --- Database (pg pool: API routes + scripts) ---
# The VM's own Postgres (pgvector). Use a session connection (port 5432) so DDL works.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME

# --- Auth.js v5 (Credentials + JWT) ---
AUTH_SECRET=                       # REQUIRED — generate fresh on the VM: npx auth secret (do NOT reuse dev's)
AUTH_URL=https://CHANGE-ME.internal.gov.my   # the real URL officers hit; must match the HTTPS reverse proxy
AUTH_TRUST_HOST=true

# --- Embeddings (Ollama bge-m3, 1024d — MUST match the vector(1024) column) ---
OLLAMA_URL=http://127.0.0.1:11434/v1
EMBED_MODEL=bge-m3

# --- Chat LLM (OpenAI-compatible endpoint = local Ollama on the VM) ---
CHAT_BASE_URL=http://127.0.0.1:11434/v1     # local Ollama, NOT OpenRouter
CHAT_MODEL=qwen2.5:7b-instruct
CHAT_API_KEY=                               # leave EMPTY — Ollama needs no key

# --- RAG gate ---
# Leave at the dev default until AFTER the full embed, then RE-TUNE per docs/vm-deployment.md
# Step 6 (scripts/diagnose-byname-gate.ts). The gate is corpus-dependent.
REFUSE_GATE=0.59

# --- MySQL source (recurring sync via scripts/sync-mysql.ts; needs VM->MySQL reachability) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
