# AGC2 environment — copy to .env.local and fill in real values.
# Local dev defaults target the docker pgvector container + local/OpenRouter LLM;
# the client VM differs by configuration, not code. See docs/local-setup.md.

# --- Database (pg pool: API routes + scripts) ---
# Local dev = the docker pgvector container (docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# --- Auth.js v5 (Credentials + JWT) ---
AUTH_SECRET=                       # required — generate with: npx auth secret
AUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true

# --- Embeddings (Ollama bge-m3, 1024d — MUST match the vector(1024) column) ---
OLLAMA_URL=http://127.0.0.1:11434/v1
EMBED_MODEL=bge-m3

# --- Chat LLM (OpenAI-compatible endpoint) ---
# Dev = OpenRouter qwen2.5-7b; on the VM point CHAT_BASE_URL at local Ollama.
CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=qwen/qwen-2.5-7b-instruct
CHAT_API_KEY=                      # or set OPENROUTER_API_KEY; leave empty for local Ollama
# OPENROUTER_API_KEY=

# --- RAG gate (optional; default 0.59) ---
# Top-similarity below this refuses without calling the LLM.
REFUSE_GATE=0.59

# --- MySQL source (recurring sync via scripts/sync-mysql.ts; needs VPN) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
